# OpenAI API key used by the planner / synthesizer LLM calls
OPENAI_API_KEY=sk-your-openai-api-key-here

# Postgres credentials for the docker-compose service. Required: choose your own password.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=langgraph_checkpoints
POSTGRES_PORT=5433

# Optional full DSN override. When unset, the DSN is assembled from the POSTGRES_* values.
# DATABASE_URL=postgresql://sentinel:change-me-local-dev-only@localhost:5433/langgraph_checkpoints
